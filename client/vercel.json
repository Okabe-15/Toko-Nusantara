{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://server-toko-nusantara.issac.biz.id/api/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "https://server-toko-nusantara.issac.biz.id/assets/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
